# Environment Configuration
ENVIRONMENT=dev

# Kubernetes
KUBECONFIG=~/.kube/config
NAMESPACE=green-devops

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_RETRY_DELAY=5

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

# Workload Prediction
PREDICTION_WINDOW_SECONDS=30
PREDICTION_MODEL_PATH=models/trained/workload_predictor_v1.pkl

# Carbon Calculation
CARBON_MODEL_PATH=models/trained/carbon_estimator_v1.pkl
CARBON_RATES_FILE=config/carbon_config.yaml

# Job Prioritization
JOB_PRIORITIZER_MODEL_PATH=models/trained/job_prioritizer_v1.pkl
JOB_POLICIES_FILE=config/job_policies.yaml

# Scaling Configuration
SLA_CONFIG_FILE=config/sla_config.yaml
SCALING_CONFIG_FILE=config/scaling_config.yaml

# Data Collection
METRIC_COLLECTION_INTERVAL=30
DATA_RETENTION_DAYS=90

# Model Retraining
RETRAINING_INTERVAL_HOURS=24
MIN_HISTORICAL_DAYS_FOR_RETRAINING=7

# Logging
LOG_DIR=logs/
LOG_LEVEL=INFO
